PORT=3000
CORS_ORIGIN=http://localhost:5173

# Postgres connection string: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Used by the app (Prisma client) and the Prisma CLI (prisma.config.ts).
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/shop

# Shopify app credentials (from the Dev Dashboard). Never commit real values.
# Product sync needs these access scopes on the app version (Dev Dashboard → app → Versions →
# Access scopes), then release the version and reopen the app in the store to approve them:
#   write_products  (productSet, productDelete)
#   write_inventory (inventorySetQuantities, inventory quantities in productSet)
#   read_inventory, read_locations (the store's primary location)
SHOPIFY_API_KEY=your-client-id
SHOPIFY_API_SECRET=your-client-secret
# Admin API version for Shopify calls (optional; defaults to 2026-10).
# SHOPIFY_API_VERSION=2026-10
# Local dev only: set to "off" to skip Shopify session-token checks. Leave unset on the server.
# SHOPIFY_AUTH=off
